cabal-version: 3.12
name:          rhayader
version:       0.0.0.0
synopsis:      A collection of composable Machine Learning engines such as Spiking NEAT, HTM, etc.
description:   Influenced by NEAT, HTM, and Active Inference.
license:       MIT
license-file:  LICENSE
author:        Fred Mitchell
maintainer:    eltoro@atomlogik.de
copyright:     2024 Fred Mitchell & Atomlogik.de
category:      Machine Learning
build-type:    Simple
extra-doc-files: CHANGELOG.org

common commons
    ghc-options:     -O2 -Wall -threaded
    build-depends:
        base >=4.7 && <5
      , pretty-simple
      , random
      , ghc
      , ghc-paths
      , ghc-prim
      , zeromq4-haskell
      , lens
      , bytestring
      , cereal
      , cborg-json
      , haskell-gi
      , async
      , stm
      , stm-chans
      , stm-containers
      , containers
      , text
      , ulid
      , wide-word
      , liquidhaskell
      , liquidhaskell-boot
      , liquid-prelude
      , unagi-chan
      , conduit
      , h-raylib
      , clock
    default-language: GHC2024
    default-extensions:
        OverloadedRecordDot
      , DuplicateRecordFields

common bincoms
    build-depends:
        mtl
      , liquidhaskell-boot
      , rhayader

library
    import: commons
    autogen-modules: Paths_rhayader
    exposed-modules:
        Engine.NEAT
      , SSMonad
      , RealNum
      , Engine.Clock
      , Engine.AI
      , Engine.Combinators
      , Engine.NEAT.Evolution.Goals
      , Engine.NEAT.Evolution.GoalTypes
      , Engine.NEAT.Genetics.Critters
      , Engine.NEAT.Genetics.Genes
      , Engine.NEAT.Genetics.GeneTypes
      , Engine.NEAT.Genetics.Neurons
      , Engine.NEAT.Population
      , Engine.NEAT.Izhikevich
      , Engine.NEAT.Visualization.Izhikevich
      , Data.SDR
      , Data.SDR.Core
      , Data.SDR.Algebras
      , Data.SDR.Encoders
      , Data.SDR.Infix
      , Data.SDR.Pooling
      , Data.SDR.Slicing
      , Data.Stream.Zio
      , Data.Stream.Zio.Common
      , Data.Stream.Zio.Dealer
      , Data.Stream.Zio.Router
    other-modules:
        Paths_rhayader
    hs-source-dirs:  lib
    build-depends:
        mtl
      , unordered-containers
      , hashable
      , data-default
      , transformers

executable sneat
    import:      commons, bincoms
    ghc-options: -rtsopts -with-rtsopts=-N
    main-is:     SNeat.hs
    hs-source-dirs: app

executable main
    import:      commons, bincoms
    ghc-options: -rtsopts -with-rtsopts=-N
    main-is:     Main.hs
    hs-source-dirs: app

